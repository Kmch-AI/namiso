# Endpoint URLs are full request URLs, for example
# https://api.openai.com/v1/chat/completions
NAMISO_EXTRACTION_URL=
NAMISO_EXTRACTION_MODEL=
NAMISO_EXTRACTION_API_KEY=
NAMISO_EXTRACTION_VERSION=
# Optional. reasoning_effort: none, minimal, low, medium, or high.
NAMISO_EXTRACTION_REASONING_EFFORT=
# Optional. Wire format: compact (default) or legacy.
NAMISO_EXTRACTION_WIRE_FORMAT=

# Embedding dimensions must match the model output.
NAMISO_EMBEDDING_URL=
NAMISO_EMBEDDING_MODEL=
NAMISO_EMBEDDING_DIMENSIONS=
NAMISO_EMBEDDING_API_KEY=
NAMISO_EMBEDDING_VERSION=
NAMISO_EMBEDDING_BATCH_SIZE=

NAMISO_RERANK_URL=
NAMISO_RERANK_MODEL=
NAMISO_RERANK_API_KEY=
# Optional request caps. Defaults: 25 documents, 240 characters each.
NAMISO_RERANK_MAX_DOCUMENTS=
NAMISO_RERANK_MAX_DOCUMENT_CHARS=

NAMISO_MODEL_TIMEOUT_MS=30000

# Set to 1 to run test/models.integration.test.ts against real endpoints.
NAMISO_RUN_MODEL_TESTS=0
