{
  "name": "namiso",
  "version": "0.1.0",
  "description": "Standalone long-term memory engine for AI agents",
  "license": "MIT",
  "files": [
    "dist",
    "spec",
    "README.md"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "oxlint -c oxlint.config.ts",
    "lint:fix": "oxlint -c oxlint.config.ts --fix",
    "fmt": "oxfmt -c oxfmt.config.ts .",
    "fmt:check": "oxfmt -c oxfmt.config.ts --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "bench": "node bench/run.ts",
    "verify": "npm run typecheck && npm run lint && npm run fmt:check && npm test"
  },
  "dependencies": {
    "sqlite-vec": "^0.1.9"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.0",
    "oxfmt": "^0.76.0",
    "oxlint": "^1.91.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=24"
  }
}
